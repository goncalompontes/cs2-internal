# Meson
build/
build-*/
_install/

# Local toolchain downloads (large, non-redistributable)
toolchain/msvc/
toolchain/msvc-wine/
toolchain/*.zip

# Fetched Vulkan headers (large; clone KhronosGroup/Vulkan-Headers into it)
external/Vulkan-Headers/

# Python
__pycache__/
*.pyc
.venv/
uv.lock
# The type checker's cache (scripts/typecheck.py writes it in the source root;
# mypy ignores its own cache directory too, this is belt and braces)
.mypy_cache/

# Rust
target/

# Local artifacts / captured dumps (never commit game binaries). The saved cell set
# the benchmark replays IS committed, so it is un-ignored explicitly.
artifacts/*
!artifacts/live-heatmap.json
*.dump
*.bin
# RE scratch: derived string dumps are large and regenerable
re/**/strings.txt

# Editor / OS
.DS_Store
*.swp

# The local protection policy (this machine's choices, not the repo's)
tools/protect/policy.local.json
