// The instruction set of the virtual machine.
//
// One file, one truth. The encoder of this task and the dispatcher of the
// interpreter (the next task) include it, so the two cannot disagree about a
// number: a hand-written copy of the table in two places is a table that
// drifts, and the drift is a silently wrong bytecode -- the failure mode
// this project exists to avoid.
//
// The list is an X-macro, and it is included *more than once* (the enum of
// the opcodes, the count of the opcodes, the interpreter's dispatcher), so
// it has no include guard: the macro is the guard.
//
//     CS2_VM_OPCODE(name, number, comment)
//
// `name` is the opcode's name, `number` its *canonical* number (dense and
// 0-based) and `comment` one line of documentation. The canonical number is
// what the interpreter's switch uses; the number that appears in the
// bytecode is the *permuted* one (see the permutation in vm.hpp), so the
// canonical number never appears in the image.
//
// The names are the ones of the specification, and they are not the house
// style's snake_case: they are the names of an external contract (the
// interpreter's dispatcher switches on them), not identifiers of this
// project.
//
// The widths, the flags and the meaning of the operands are documented in
// vm.hpp: the header of the bytecode is the contract, and this file is the
// list of the opcodes it holds.
//
// The `width` of an instruction is in **bytes** (1, 2, 4 or 8), so a shift
// masks its amount to `width * 8 - 1` **bits** (7, 15, 31 or 63), and the
// `i1` of the source IR lives in a byte.

#ifndef CS2_VM_OPCODE
#error "isa.def is an X-macro list: define CS2_VM_OPCODE(name, number, comment) first"
#endif

// --- The values ---------------------------------------------------------------

CS2_VM_OPCODE(Const, 0, "dst = imm, extended to the width")
CS2_VM_OPCODE(Move, 1, "dst = src1, truncated to the width")
CS2_VM_OPCODE(Add, 2, "dst = src1 + src2, at the width")
CS2_VM_OPCODE(Sub, 3, "dst = src1 - src2, at the width")
CS2_VM_OPCODE(Mul, 4, "dst = src1 * src2, at the width")
CS2_VM_OPCODE(And, 5, "dst = src1 & src2, at the width")
CS2_VM_OPCODE(Or, 6, "dst = src1 | src2, at the width")
CS2_VM_OPCODE(Xor, 7, "dst = src1 ^ src2, at the width")
CS2_VM_OPCODE(SDiv, 8, "dst = src1 / src2, signed, at the width")
CS2_VM_OPCODE(UDiv, 9, "dst = src1 / src2, unsigned, at the width")
CS2_VM_OPCODE(SRem, 10, "dst = src1 % src2, signed, at the width")
CS2_VM_OPCODE(URem, 11, "dst = src1 % src2, unsigned, at the width")
CS2_VM_OPCODE(Shl, 12, "dst = src1 << src2, the amount masked to width*8-1")
CS2_VM_OPCODE(LShr, 13, "dst = src1 >> src2, logical, the amount masked to width*8-1")
CS2_VM_OPCODE(AShr, 14, "dst = src1 >> src2, arithmetic, the amount masked to width*8-1")
CS2_VM_OPCODE(Neg, 15, "dst = -src1, at the width")
CS2_VM_OPCODE(Not, 16, "dst = ~src1, at the width")
CS2_VM_OPCODE(Cmp, 17, "dst = 1 if the comparison holds, else 0; aux = the kind")
CS2_VM_OPCODE(Cast, 18, "dst = src1 converted; aux = the kind and the source width")
CS2_VM_OPCODE(Load, 19, "dst = *(iN*)src1; aux = the size in bytes")
CS2_VM_OPCODE(Store, 20, "*(iN*)src1 = src2; aux = the size in bytes")
CS2_VM_OPCODE(Gep, 21, "dst = src1 + imm, a signed byte offset")
CS2_VM_OPCODE(Br, 22, "pc = the instruction index in aux")
CS2_VM_OPCODE(BrIf, 23, "if src1 != 0, pc = the instruction index in aux")
CS2_VM_OPCODE(Arg, 24, "push src1 onto the argument stack")
CS2_VM_OPCODE(Pop, 25, "dst = the top of the argument stack, popped")
CS2_VM_OPCODE(Call, 26, "dst = the result; imm = the pool index; aux = the argument count; the arguments are the top aux cells of the argument stack, the first argument of the call first")
CS2_VM_OPCODE(Ret, 27, "return src1")
CS2_VM_OPCODE(MemCpy, 28, "copy imm bytes from src2 to src1")
CS2_VM_OPCODE(MemSet, 29, "set imm bytes at src1 to the byte in src2")
CS2_VM_OPCODE(Pool, 30, "dst = the pool entry imm (a relocatable pointer)")
