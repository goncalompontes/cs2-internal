{
  "$schema": "https://opencode.ai/config.json",

  // Built-in LSP: clangd auto-installs for C/C++ (Meson emits
  // compile_commands.json), pyright for Python, rust-analyzer for Rust.
  "lsp": true,

  "mcp": {
    "timeout": {
      // ReVa boots Ghidra/pyghidra, which is slow on first startup.
      "startup": 120000
    },
    "servers": {
      // Ghidra-powered static RE (headless). Requires:
      //   - Ghidra 12.x extracted (toolchain/ghidra/)
      //   - `uv tool install reverse-engineering-assistant`
      "ReVa": {
        "type": "local",
        "command": ["/home/pontes/.local/bin/mcp-reva"],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/home/pontes/cs2-internal/toolchain/ghidra/ghidra_12.1.4_PUBLIC"
        }
      },
      // Token-cheap structural code views (AST-first).
      "treesitter": {
        "type": "local",
        "command": ["/home/pontes/.local/bin/treesitter-mcp"]
      }
    }
  }
}
