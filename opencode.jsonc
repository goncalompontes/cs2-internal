{
  "$schema": "https://opencode.ai/config.json",

  // Built-in LSP: clangd auto-installs for C/C++ (Meson emits
  // compile_commands.json), pyright for Python, rust-analyzer for Rust.
  "lsp": true,

  "mcp": {
    "timeout": {
      // REA boots Ghidra, which is slow on first startup.
      "startup": 120000
    },
    "servers": {
      // Static RE is provided by the global `rea` server (see
      // ~/.config/opencode/opencode.jsonc). Ghidra is installed globally at
      // ~/.local/share/ghidra; this project carries no local copy.
      // Token-cheap structural code views (AST-first).
      "treesitter": {
        "type": "local",
        "command": ["/home/pontes/.local/bin/treesitter-mcp"]
      },
      // Live memory analysis of a running target (native /proc backend).
      // Attach by process name; narrow values, resolve pointer chains, scan
      // patterns, enumerate interfaces. Built on demand by the wrapper.
      "cs2-live": {
        "type": "local",
        "command": ["/home/pontes/cs2-internal/scripts/mcp-live.sh"]
      }
    }
  }
}
